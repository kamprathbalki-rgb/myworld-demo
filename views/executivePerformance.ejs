<!DOCTYPE html>
<html>

<head>

<title>Executive Productivity Dashboard</title>

<style>

body{
    font-family:Arial;
    background:#f4f6f9;
    margin:20px;
}

h1{
    margin-bottom:20px;
}

table{
    width:100%;
    border-collapse:collapse;
    background:#fff;
}

th,td{
    padding:10px;
    border:1px solid #ddd;
    text-align:center;
}

th{
    background:#2c3e50;
    color:white;
}

tr:nth-child(even){
    background:#fafafa;
}

a{
    color:#1565c0;
    text-decoration:none;
    font-weight:bold;
}

a:hover{
    text-decoration:underline;
}

.top-links{
    margin-bottom:20px;
}

.top-links a{
    margin-right:15px;
}

</style>

</head>

<body>

<div class="top-links">

<a href="javascript:history.back()">⬅ Back</a>

<% if (isExecutive) { %>

<a href="/executive/dashboard">🏠 Home</a>

<% } else if (isHR) { %>

<a href="/hr/dashboard">🏠 Home</a>

<% } else { %>

<a href="/dashboard/main">🏠 Home</a>

<% } %>


<% if (isExecutive) { %>

<a href="/executive/logout">🚪 Logout</a>

<% } else if (isHR) { %>

<a href="/hr/logout">🚪 Logout</a>

<% } else { %>

<a href="/logout">🚪 Logout</a>

<% } %>

</div>

<h1>Executive Productivity Dashboard</h1>

<div style="margin-bottom:15px;">

<form
action="/dashboard/executive-performance/export"
method="GET"
style="display:inline;">

<input
type="hidden"
name="fromDate"
value="<%= fromDate || '' %>">

<input
type="hidden"
name="toDate"
value="<%= toDate || '' %>">

<button
type="submit"
style="
background:#28a745;
color:white;
border:none;
padding:10px 18px;
border-radius:5px;
cursor:pointer;
font-weight:bold;">

📥 Export to Excel

</button>

</form>

</div>

<table>

<tr>

<th>Rank</th>

<th>Executive</th>

<th>Imported</th>

<th>Phone Call</th>

<th>Qualified</th>

<th>Site Visit</th>

<th>Negotiation</th>

<th>Won</th>

<th>Lost</th>

</tr>

<% data.forEach(function(e){ %>

<tr>

<td>
<%= e.rank %>
</td>

<td>
<b><%= e.executive %></b>
</td>

<td>
<a href="/dashboard/executive-buyers/<%= e.executiveId %>/Imported">
<%= e.imported %>
</a>
</td>

<td>
<a href="/dashboard/executive-buyers/<%= e.executiveId %>/Phone%20Call">
<%= e.phoneCall %>
</a>
</td>

<td>
<a href="/dashboard/executive-buyers/<%= e.executiveId %>/Qualified">
<%= e.qualified %>
</a>
</td>

<td>
<a href="/dashboard/executive-buyers/<%= e.executiveId %>/Site%20Visit">
<%= e.siteVisit %>
</a>
</td>

<td>
<a href="/dashboard/executive-buyers/<%= e.executiveId %>/Negotiation">
<%= e.negotiation %>
</a>
</td>

<td>
<a href="/dashboard/executive-buyers/<%= e.executiveId %>/Won">
<%= e.won %>
</a>
</td>

<td>
<a href="/dashboard/executive-buyers/<%= e.executiveId %>/Lost">
<%= e.lost %>
</a>
</td>

</tr>

<% }) %>

<tr style="background:#e8f4ff;font-weight:bold;">

<td></td>

<td>Total</td>

<td><%= totals.imported %></td>

<td><%= totals.phoneCall %></td>

<td><%= totals.qualified %></td>

<td><%= totals.siteVisit %></td>

<td><%= totals.negotiation %></td>

<td><%= totals.won %></td>

<td><%= totals.lost %></td>

</tr>
</table>

<br>

<h2>Pipeline Movement</h2>

<table>

<tr>

<th>Executive</th>

<th>Imported → Phone</th>

<th>Phone → Qualified</th>

<th>Qualified → Visit</th>

<th>Visit → Negotiation</th>

<th>Negotiation → Won</th>

<th>Negotiation → Lost</th>

</tr>

<% data.forEach(function(e){ %>

<tr>

<td><b><%= e.executive %></b></td>

<td><%= e.importedToPhone || 0 %></td>

<td><%= e.phoneToQualified || 0 %></td>

<td><%= e.qualifiedToSiteVisit || 0 %></td>

<td><%= e.siteVisitToNegotiation || 0 %></td>

<td><%= e.negotiationToWon || 0 %></td>

<td><%= e.negotiationToLost || 0 %></td>

</tr>

<% }) %>

<tr style="background:#e8f4ff;font-weight:bold;">

<td>Total</td>

<td><%= totals.importedToPhone %></td>

<td><%= totals.phoneToQualified %></td>

<td><%= totals.qualifiedToSiteVisit %></td>

<td><%= totals.siteVisitToNegotiation %></td>

<td><%= totals.negotiationToWon %></td>

<td><%= totals.negotiationToLost %></td>

</tr>

</table>

</body>

</html>