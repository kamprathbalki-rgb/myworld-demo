<!DOCTYPE html>
<html>
<head>

<title>Edit Buyer</title>

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<link rel="stylesheet" href="/css/editUnqualifiedBuyer.css">


</head>

<body>

<div class="container">

<div class="page-header">

    <a href="<%= buyer.currentOwnerRole === 'PreSales'
    ? '/executive/unqualified'
    : 'javascript:history.back()' %>" class="header-link">←</a>

<a href="<%= buyer.currentOwnerRole === 'PreSales'
    ? '/executive/unqualified'
    : '/dashboard' %>" class="header-link">🏠</a>

    <h1>👤 Edit Buyer</h1>

    <a href="<%= buyer.currentOwnerRole === 'PreSales'
    ? '/executive/unqualified'
    : '/dashboard' %>" class="header-link">🏠</a>

</div>

<form
    id="buyerForm"
    method="POST"
    action="/executive/update-unqualified/<%= buyer._id %>"
>

<div class="card">

<div class="section-title">
    👤 Basic Buyer Details
</div>

<div class="form-grid">

<div class="field">
<label>Name</label>
<input type="text" name="name" value="<%= buyer.name || '' %>">
</div>

<div class="field">
    <label>📱 Mobile Number</label>
    <input
        type="text"
        name="phone"
        value="<%= buyer.phone || '' %>">
</div>

<div class="field full-width">

    <label>WhatsApp Number</label>

    <div style="display:flex;align-items:center;gap:15px;">

<input
    type="text"
    name="whatsappNumber"
    value="<%= buyer.whatsappNumber || '' %>"
    style="flex:1;height:42px;">

        <label style="display:flex;align-items:center;gap:5px;white-space:nowrap;margin:0;">
            <input
                type="radio"
                name="isWhatsAppSame"
                value="true"
                <%= buyer.isWhatsAppSame !== false ? "checked" : "" %>>
            Same
        </label>

        <label style="display:flex;align-items:center;gap:5px;white-space:nowrap;margin:0;">
            <input
                type="radio"
                name="isWhatsAppSame"
                value="false"
                <%= buyer.isWhatsAppSame === false ? "checked" : "" %>>
            Different
        </label>

    </div>

</div>

<div class="field">

    <label>📧 Email</label>

    <input
        type="email"
        name="email"
        value="<%= buyer.email || '' %>">

    <div style="margin-top:10px;display:flex;gap:20px;">

        <label style="display:flex;align-items:center;gap:5px;">
            <input
                type="radio"
                name="emailStatus"
                value="Verified"
                <%= buyer.emailStatus === "Verified" ? "checked" : "" %>>
            Verified
        </label>

        <label style="display:flex;align-items:center;gap:5px;">
            <input
                type="radio"
                name="emailStatus"
                value="Not Available"
                <%= buyer.emailStatus === "Not Available" ? "checked" : "" %>>
            Not Available
        </label>

        <label style="display:flex;align-items:center;gap:5px;">
            <input
                type="radio"
                name="emailStatus"
                value="Will Share Later"
                <%= buyer.emailStatus === "Will Share Later" || !buyer.emailStatus ? "checked" : "" %>>
            Will Share Later
        </label>

    </div>

</div>

</div>

<div class="card">

<div class="section-title">
🏠 Buying Interest
</div>

<div class="field">

<label>Are you interested in buying a property?</label>

<div style="display:flex;gap:25px;margin-top:10px;">

<label>
<input type="radio"
       name="buyingInterest"
       value="Yes"
       <%= buyer.buyingInterest === "Yes" ? "checked" : "" %>>
Yes
</label>

<label>
<input type="radio"
       name="buyingInterest"
       value="No"
       <%= buyer.buyingInterest === "No" ? "checked" : "" %>>
No
</label>

</div>

</div>

<div id="notInterestedBlock"
     style="<%= buyer.buyingInterest === 'No' ? '' : 'display:none' %>;margin-top:15px;">

<label>Reason</label>

<select name="notInterestedReason">

<option value="">Select</option>

<option value="Already Bought"
<%= buyer.notInterestedReason==="Already Bought"?"selected":"" %>>
Already Bought
</option>

<option value="Not Interested"
<%= buyer.notInterestedReason==="Not Interested"?"selected":"" %>>
Not Interested
</option>

</select>

<div id="alreadyBoughtBlock"
     style="<%= buyer.notInterestedReason === 'Already Bought' ? '' : 'display:none' %>">

<label>Builder / Project</label>

<input
    type="text"
    name="boughtBuilder"
    value="<%= buyer.boughtBuilder || '' %>"
    placeholder="Builder or Project Name">

</div>

</div>

</div>


<div id="yesBlock"
     style="<%= buyer.buyingInterest === 'Yes' ? '' : 'display:none' %>;margin-top:15px;">

<label>Purchase Timeline</label>

<select name="purchaseTimeline">

<option value="">Select</option>

<option value="Immediate"
<%= buyer.purchaseTimeline==="Immediate"?"selected":"" %>>
Immediate
</option>

<option value="1 Month"
<%= buyer.purchaseTimeline==="1 Month"?"selected":"" %>>
1 Month
</option>

<option value="3 Months"
<%= buyer.purchaseTimeline==="3 Months"?"selected":"" %>>
3 Months
</option>

<option value="6 Months"
<%= buyer.purchaseTimeline==="6 Months"?"selected":"" %>>
6 Months
</option>

<option value="6+ Months"
<%= buyer.purchaseTimeline==="6+ Months"?"selected":"" %>>
6+ Months
</option>

</select>

</div>


<div class="card">

<div class="section-title">
    💰 Budget & Requirement
</div>

<div class="form-grid">

<div class="field">
<label>Min Budget</label>
<input type="number" name="minBudget" value="<%= buyer.minBudget || '' %>">
</div>

<div class="field">
<label>Max Budget</label>
<input type="number" name="maxBudget" value="<%= buyer.maxBudget || '' %>">
</div>

<div class="field">
    <label>Buyer Value (₹)</label>
    <input
        type="number"
        name="buyerValue"
        value="<%= buyer.buyerValue || '' %>">
</div>

<div
    class="field full-width"
    id="buyerValueConfirmationBlock"
    style="display:none;">

    <label>
        <input
            type="checkbox"
            id="confirmBuyerValue"
            name="confirmBuyerValue">
        I confirm this is the final Buyer Value.
    </label>

</div>

<div class="field full-width">

<label>Transaction Type</label>

<select name="transactionType">

<option value="SALE" <%= buyer.transactionType === 'SALE' ? 'selected' : '' %>>
Sale
</option>

<option value="RENT" <%= buyer.transactionType === 'RENT' ? 'selected' : '' %>>
Rent
</option>

<option value="LEASE" <%= buyer.transactionType === 'LEASE' ? 'selected' : '' %>>
Lease
</option>

</select>

</div>

</div>

<br>

<div class="field-label">
Required Possession
</div>

<div class="checkbox-group">

<label class="check-option">
<input type="checkbox" name="requiredPossession" value="Immediate"
<%= buyer.requiredPossession && buyer.requiredPossession.includes('Immediate') ? 'checked' : '' %>>
Immediate
</label>

<label class="check-option">
<input type="checkbox" name="requiredPossession" value="Ready Possession"
<%= buyer.requiredPossession && buyer.requiredPossession.includes('Ready Possession') ? 'checked' : '' %>>
Ready Possession
</label>

<label class="check-option">
<input type="checkbox" name="requiredPossession" value="Under Construction"
<%= buyer.requiredPossession && buyer.requiredPossession.includes('Under Construction') ? 'checked' : '' %>>
Under Construction
</label>

<label class="check-option">
<input type="checkbox" name="requiredPossession" value="Possession Soon"
<%= buyer.requiredPossession && buyer.requiredPossession.includes('Possession Soon') ? 'checked' : '' %>>
Possession Soon
</label>

</div>

</div>


<div class="card">

<div class="section-title">
    🏠 Property Requirement
</div>

<div class="tabs">

<button type="button" class="tab-btn" onclick="showBuyerTab('apartmentBuyerTab')">
🏢 Apartment (BHK)
</button>

<button type="button" class="tab-btn" onclick="showBuyerTab('otherBuyerTab')">
🏡 Villa / Plot / Commercial
</button>

</div>


<div id="apartmentBuyerTab">

<div class="form-grid">

<div class="field">

<label>Required Flat Type</label>

<select name="apartmentFlatType">

<option value="">Select</option>
<option <%= buyer.requiredFlatType === 'Studio' ? 'selected' : '' %>>Studio</option>
<option <%= buyer.requiredFlatType === '1 RK' ? 'selected' : '' %>>1 RK</option>
<option <%= buyer.requiredFlatType === '1 BHK' ? 'selected' : '' %>>1 BHK</option>
<option <%= buyer.requiredFlatType === '1.5 BHK' ? 'selected' : '' %>>1.5 BHK</option>
<option <%= buyer.requiredFlatType === '2 BHK' ? 'selected' : '' %>>2 BHK</option>
<option <%= buyer.requiredFlatType === '2.5 BHK' ? 'selected' : '' %>>2.5 BHK</option>
<option <%= buyer.requiredFlatType === '3 BHK' ? 'selected' : '' %>>3 BHK</option>
<option <%= buyer.requiredFlatType === '3.5 BHK' ? 'selected' : '' %>>3.5 BHK</option>
<option <%= buyer.requiredFlatType === '4 BHK' ? 'selected' : '' %>>4 BHK</option>
<option <%= buyer.requiredFlatType === '4.5 BHK' ? 'selected' : '' %>>4.5 BHK</option>
<option <%= buyer.requiredFlatType === '5 BHK' ? 'selected' : '' %>>5 BHK</option>
<option <%= buyer.requiredFlatType === '5+ BHK' ? 'selected' : '' %>>5+ BHK</option>

</select>

</div>

<div class="field">
<label>Min Carpet Area</label>
<input type="number" name="apartmentMinArea" value="<%= buyer.minArea || '' %>">
</div>

<div class="field">
<label>Max Carpet Area</label>
<input type="number" name="apartmentMaxArea" value="<%= buyer.maxArea || '' %>">
</div>

</div>

</div>


<div id="otherBuyerTab" style="display:none">

<div class="form-grid">

<div class="field">

<label>Required Type</label>

<select name="otherFlatType">
<option value="">Select</option>
<option <%= buyer.requiredFlatType === 'Villa' ? 'selected' : '' %>>Villa</option>
<option <%= buyer.requiredFlatType === 'Plot' ? 'selected' : '' %>>Plot</option>
<option <%= buyer.requiredFlatType === 'Office' ? 'selected' : '' %>>Office</option>
<option <%= buyer.requiredFlatType === 'Showroom' ? 'selected' : '' %>>Showroom</option>
<option <%= buyer.requiredFlatType === 'Retail' ? 'selected' : '' %>>Retail</option>
<option <%= buyer.requiredFlatType === 'Shop' ? 'selected' : '' %>>Shop</option>
</select>

</div>

<div class="field">
<label>Min Area</label>
<input type="number" name="otherMinArea" value="<%= buyer.minArea || '' %>">
</div>

<div class="field">
<label>Max Area</label>
<input type="number" name="otherMaxArea" value="<%= buyer.maxArea || '' %>">
</div>

</div>

</div>

</div>


<div class="card">

<div class="section-title">
📍 Location Preferences
</div>


<div id="locationSelects" style="display:none;">
<div class="form-grid">

<div class="field full-width">

<label>1st Preference (Required)</label>
<select name="preferredLocation1" required>
<option value="">Select Location</option>
<% locations.forEach(function(location){ %>
<option
value="<%= location.officeName %>"

<%=
buyer.preferredLocations &&
buyer.preferredLocations[0].replace(/\s+(B\.O|S\.O|H\.O)$/i, "") ===
location.officeName.replace(/\s+(B\.O|S\.O|H\.O)$/i, "")
? "selected"
: ""
%>

>
<%= location.officeName %>
(<%= location.divisionName %>, <%= location.district %>)
</option>

<% }) %>
</select>
</div>

<div class="field">

<label>2nd Preference (Optional)</label>
<select name="preferredLocation2">
<option value="">Not Required</option>
<% locations.forEach(function(location){ %>
<option
value="<%= location.officeName %>"

<%=
(
    ((buyer.preferredLocations && buyer.preferredLocations[1]) || "")
        .replace(/\s+(B\.O|S\.O|H\.O)$/i, "") ===
    location.officeName.replace(/\s+(B\.O|S\.O|H\.O)$/i, "")
)
? "selected"
: ""
%>

>
<%= location.officeName %>
(<%= location.divisionName %>, <%= location.district %>)
</option>
<% }) %>
</select>
</div>


<div class="field">

<label>3rd Preference (Optional)</label>
<select name="preferredLocation3">
<option value="">Not Required</option>
<% locations.forEach(function(location){ %>
<option
value="<%= location.officeName %>"

<%=
(
    ((buyer.preferredLocations && buyer.preferredLocations[2]) || "")
        .replace(/\s+(B\.O|S\.O|H\.O)$/i, "") ===
    location.officeName.replace(/\s+(B\.O|S\.O|H\.O)$/i, "")
)
? "selected"
: ""
%>

>

<%= location.officeName %>
(<%= location.divisionName %>, <%= location.district %>)
</option>
<% }) %>
</select>
</div>
</div>
</div>

<div class="card">

    <div class="section-title">
        🔍 Location Search
    </div>

    <div class="field">

        <label>Search Location</label>

        <input
            type="text"
            id="locationSearch"
            placeholder="Type Bavdhan, Baner, Wakad..."
            autocomplete="off">

    </div>

    <div
        id="locationResults"
        class="location-results">
    </div>


    <div id="selectedLocations">

    <div class="location-row">

        <div>
            <div class="location-label">
                1st Preference
            </div>

            <div
                id="selectedLocation1"
                class="selected-location-text">

                <%= buyer.preferredLocations && buyer.preferredLocations[0]
                    ? buyer.preferredLocations[0]
                    : "Not Selected" %>

            </div>
        </div>

        <button
            type="button"
            class="location-select-btn"
            onclick="changeLocation(1)">
            Select-1
        </button>

    </div>


    <div class="location-row">

        <div>

            <div class="location-label">
                2nd Preference
            </div>

            <div
                id="selectedLocation2"
                class="selected-location-text">

                <%= buyer.preferredLocations && buyer.preferredLocations[1]
                    ? buyer.preferredLocations[1]
                    : "Not Selected" %>

            </div>

        </div>

        <button
            type="button"
            class="location-select-btn"
            onclick="changeLocation(2)">
            Select-2
        </button>

    </div>


    <div class="location-row">

        <div>

            <div class="location-label">
                3rd Preference
            </div>

            <div
                id="selectedLocation3"
                class="selected-location-text">

                <%= buyer.preferredLocations && buyer.preferredLocations[2]
                    ? buyer.preferredLocations[2]
                    : "Not Selected" %>

            </div>

        </div>

        <button
            type="button"
            class="location-select-btn"
            onclick="changeLocation(3)">
            Select-3
        </button>

    </div>

</div>

</div>




<div class="form-group full-width">
    <label>Buyer Notes</label>
<textarea
    name="buyerNotes"
    class="form-control"
    rows="4"
    placeholder="Enter buyer notes..."><%= buyer.buyerNotes || '' %></textarea>
</div>

</div>


<div class="card">

<div class="section-title">
🌍 Geo Preference (Optional)
</div>

<div class="form-grid">

<div class="field">
<label>Longitude</label>
<input type="text" name="lng"
value="<%= buyer.preferredLocation && buyer.preferredLocation.coordinates ? buyer.preferredLocation.coordinates[0] : '' %>">
</div>

<div class="field">
<label>Latitude</label>
<input type="text" name="lat"
value="<%= buyer.preferredLocation && buyer.preferredLocation.coordinates ? buyer.preferredLocation.coordinates[1] : '' %>">
</div>

<div class="field">
<label>Radius (meters)</label>
<input type="number" name="radius" value="<%= buyer.radius || '' %>">
</div>

</div>

</div>


<div class="card">

<div class="section-title">
📝 Lead Status & Follow Up
</div>

<div class="form-grid">

<div class="field">
<label>Status</label>
<input type="text" name="status" value="<%= buyer.status || '' %>">
</div>

<br><br>

<div class="field">
    <label>Last Follow-up</label>
    <input
        type="text"
        value="<%= buyer.lastFollowUp ? buyer.lastFollowUp.toLocaleString('en-IN',{ timeZone:'Asia/Kolkata' }) : '' %>"
        readonly>
</div>

<div class="field">
    <label>Follow-up Date & Time</label>
    <input
        type="datetime-local"
        name="nextFollowUp"
        value="<%= buyer.nextFollowUp ? new Date(buyer.nextFollowUp.getTime() + 330*60000).toISOString().slice(0,16) : '' %>">
</div>

<div class="field">
    <label>Last Site Visit</label>
    <input
        type="text"
        value="<%= buyer.lastSiteVisitDate ? buyer.lastSiteVisitDate.toLocaleString('en-IN',{ timeZone:'Asia/Kolkata' }) : '' %>"
        readonly>
</div>

<div class="field">
    <label>Site Visit Date & Time</label>
    <input
        type="datetime-local"
        name="siteVisitDate"
        value="<%= buyer.siteVisitDate ? new Date(buyer.siteVisitDate.getTime() + 330*60000).toISOString().slice(0,16) : '' %>">
</div>

<br><br>

<div class="field full-width">
<label>Follow Up Notes</label>
<textarea name="followUpNotes" rows="4"><%= buyer.followUpNotes || '' %></textarea>
</div>

</div>

</div>


<button type="submit" class="update-btn">
💾 Update Buyer
</button>


<input
    type="hidden"
    name="qualificationDate"
    value="<%= buyer.qualificationDate ? buyer.qualificationDate.toISOString() : '' %>">

</form>

</div>

<script>

function showBuyerTab(tabId) {
    document.getElementById('apartmentBuyerTab').style.display = 'none';
    document.getElementById('otherBuyerTab').style.display = 'none';
    document.getElementById(tabId).style.display = 'block';
}

function validateLocations() {

    const p1 = document.querySelector('[name="preferredLocation1"]').value
    const p2 = document.querySelector('[name="preferredLocation2"]').value
    const p3 = document.querySelector('[name="preferredLocation3"]').value

    const values = [p1, p2, p3].filter(v => v)

    const unique = new Set(values)

    if (values.length !== unique.size) {
        alert('Please select different locations')
        return false
    }

    return true
}

document.querySelector('form')
.addEventListener('submit', function(e){

    if (!validateLocations()) {
        e.preventDefault();
        return;
    }

    const status =
        document.querySelector('[name="status"]').value;

const previousStatus = "<%= buyer.status %>";

const nextFollowUp =
    document.querySelector('[name="nextFollowUp"]').value;

const siteVisitDate =
    document.querySelector('[name="siteVisitDate"]').value;

const buyerValue =
    Number(document.querySelector('[name="buyerValue"]').value || 0);

const now = new Date();

if (
    previousStatus === "Phone Call" &&
    previousStatus !== status &&
    status === "Qualified"
) {

    if (!nextFollowUp) {
        alert("Next Follow-up Date & Time is mandatory.");
        e.preventDefault();
        return;
    }

    if (new Date(nextFollowUp) < now) {
        alert("Next Follow-up Date & Time cannot be in the past.");
        e.preventDefault();
        return;
    }

}

if (
    previousStatus === "Qualified" &&
    status === "Site Visit"
) {

    if (!nextFollowUp) {
        alert("Next Follow-up Date & Time is mandatory.");
        e.preventDefault();
        return;
    }

    if (new Date(nextFollowUp) < now) {
        alert("Next Follow-up Date & Time cannot be in the past.");
        e.preventDefault();
        return;
    }

    if (!siteVisitDate) {
        alert("Site Visit Date & Time is mandatory.");
        e.preventDefault();
        return;
    }

    if (new Date(siteVisitDate) < now) {
        alert("Site Visit Date & Time cannot be in the past.");
        e.preventDefault();
        return;
    }

}

if (
    previousStatus === "Site Visit" &&
    status === "Negotiation"
) {

    if (!nextFollowUp) {
        alert("Next Follow-up Date & Time is mandatory.");
        e.preventDefault();
        return;
    }

    if (new Date(nextFollowUp) < now) {
        alert("Next Follow-up Date & Time cannot be in the past.");
        e.preventDefault();
        return;
    }

    if (buyerValue <= 0) {
        alert("Buyer Value must be greater than zero.");
        e.preventDefault();
        return;
    }

}




    if (
        ["Deal Won", "Lost", "Dropped"].includes(status)
    ) {

        if (
            !document.querySelector('[name="buyerValue"]').value
        ) {
            alert("Enter Buyer Value.");
            e.preventDefault();
            return;
        }

        if (
            !document.getElementById("confirmBuyerValue").checked
        ) {
            alert("Please confirm the Buyer Value.");
            e.preventDefault();
            return;
        }

    }

});

const radios = document.querySelectorAll('input[name="buyingInterest"]');

const noBlock = document.getElementById("notInterestedBlock");
const yesBlock = document.getElementById("yesBlock");

radios.forEach(r => {

    r.addEventListener("change", function () {

        if (this.value === "Yes") {

            yesBlock.style.display = "block";
            noBlock.style.display = "none";

        } else {

            yesBlock.style.display = "none";
            noBlock.style.display = "block";

        }

    });

});

const statusInput = document.querySelector('[name="status"]');
const confirmationBlock = document.getElementById("buyerValueConfirmationBlock");

function toggleBuyerValueConfirmation() {

    if (
        ["Deal Won", "Lost", "Dropped"].includes(statusInput.value)
    ) {
        confirmationBlock.style.display = "block";
    } else {
        confirmationBlock.style.display = "none";
    }

}

toggleBuyerValueConfirmation();

statusInput.addEventListener(
    "change",
    toggleBuyerValueConfirmation
);

let editingPreference = 1;

function changeLocation(preference) {

    editingPreference = preference;

    document.getElementById("locationSearch").focus();

    document.getElementById("locationSearch").select();

}

const searchBox = document.getElementById("locationSearch");
const resultsBox = document.getElementById("locationResults");

searchBox.addEventListener("input", function () {

    const keyword = this.value.trim().toLowerCase();

    if (keyword.length < 2) {

        resultsBox.style.display = "none";
        resultsBox.innerHTML = "";

        return;

    }

    const select =
        document.querySelector(
            '[name="preferredLocation1"]'
        );

    resultsBox.innerHTML = "";

    Array.from(select.options).forEach(option => {

        if (!option.value) return;

        if (
            option.text.toLowerCase().includes(keyword)
        ) {

            const row =
                document.createElement("div");

            row.className = "location-item";

            row.innerHTML =
                "<strong>" +
                option.value +
                "</strong>";

row.onclick = function () {

    const p1 = document.querySelector('[name="preferredLocation1"]').value;
    const p2 = document.querySelector('[name="preferredLocation2"]').value;
    const p3 = document.querySelector('[name="preferredLocation3"]').value;

    const selected = [p1, p2, p3];

    const duplicate =
        selected.some((value, index) =>
            value === option.value &&
            index !== (editingPreference - 1)
        );

    if (duplicate) {

        alert("Location already selected.");

        return;

    }

    const hiddenSelect =
        document.querySelector(
            '[name="preferredLocation' +
            editingPreference +
            '"]'
        );

    hiddenSelect.value = option.value;

    document.getElementById(
        "selectedLocation" +
        editingPreference
    ).innerText = option.value;

    resultsBox.innerHTML = "";
    resultsBox.style.display = "none";
    searchBox.value = "";

};

            resultsBox.appendChild(row);

        }

    });

    resultsBox.style.display =
        resultsBox.innerHTML
            ? "block"
            : "none";

});


</script>

</body>
</html>