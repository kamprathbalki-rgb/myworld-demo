<!-- ================================
     Unqualified Lead Records
================================ -->

<div class="buyer-section">

<div class="kanban-container">


<h2 class="section-title">
Unqualified Lead Records
</h2>

<%
function getColumnValue(status){

    return buyers
        .filter(b => b.status === status)
        .reduce((total, b) => {

            const min = Number(b.minBudget) || 0;
            const max = Number(b.maxBudget) || 0;

            return total + ((min + max) / 2);

        }, 0);

}

function formatAmount(value){

    if(value >= 10000000){
        return "₹" + (value / 10000000).toFixed(2) + " Cr";
    }

    if(value >= 100000){
        return "₹" + (value / 100000).toFixed(2) + " L";
    }

    return "₹" + value.toLocaleString("en-IN");

}

function getLeadAge(createdAt){

    if(!createdAt){
        return {
            days: 0,
            color: "#6c757d",
            label: "0 Days"
        };
    }

    const created = new Date(createdAt);
    const today = new Date();

    const days = Math.floor(
        (today - created) / (1000 * 60 * 60 * 24)
    );

    if(days <= 7){
        return {
            days,
            color: "#28a745",
            label: days + " Days"
        };
    }

    if(days <= 15){
        return {
            days,
            color: "#ffc107",
            label: days + " Days"
        };
    }

    return {
        days,
        color: "#dc3545",
        label: days + " Days"
    };

}

%>

<div class="kanban-board">

<div class="kanban-column"
     data-status="Imported">

    <div class="drop-zone"
         ondragover="allowDrop(event)"
         ondrop="dropLead(event)">

<h3>
    Imported
    (<%= buyers.filter(b => b.status === "Imported").length %> |
    <%= formatAmount(getColumnValue("Imported")) %>)
</h3>

<div
    class="page-nav"
    data-column="Imported">

    <button
        type="button"
        class="prev-btn"
        disabled>
        ◀
    </button>

    <span class="page-range">
        1–5
    </span>

    <button
        type="button"
        class="next-btn">
        ▶
    </button>

</div>

    <% buyers
        .filter(b => b.status === "Imported")
        .forEach(function(b){ %>

<%- include("partials/unqualifiedLeadCard", {
    buyer: b,
    getLeadAge: getLeadAge,
    executives: executives
}) %>

    <% }) %>

</div>
</div>

<div class="kanban-column"
     data-status="Phone Call">

    <div class="drop-zone"
         ondragover="allowDrop(event)"
         ondrop="dropLead(event)">

<h3>
Phone Call
(<%= buyers.filter(b => b.status === "Phone Call").length %> |
<%= formatAmount(getColumnValue("Phone Call")) %>)
</h3>

<% buyers
.filter(b => b.status === "Phone Call")
.forEach(function(b){ %>

<%- include("partials/unqualifiedLeadCard",{
