<h3>
Qualified
(<%= buyers.filter(b => b.status === "Qualified").length %> |
<%= formatAmount(getColumnValue("Qualified")) %>)
</h3>

<% buyers
.filter(b => b.status === "Qualified")
.forEach(function(b){ %>

<%- include("partials/unqualifiedLeadCard",{
buyer:b,
getLeadAge:getLeadAge
}) %>

<% }) %>

</div>

</div>

<div class="kanban-column"
     data-status="Site Visit">

    <div class="drop-zone"
     ondragover="allowDrop(event)"
     ondrop="dropLead(event)">

<h3>
Site Visit
(<%= buyers.filter(b => b.status === "Site Visit").length %> |
<%= formatAmount(getColumnValue("Site Visit")) %>)
</h3>

<% buyers
.filter(b => b.status === "Site Visit")
.forEach(function(b){ %>

<%- include("partials/unqualifiedLeadCard",{
buyer:b,
getLeadAge:getLeadAge
}) %>

<% }) %>

</div>

</div>

<div class="kanban-column"
     data-status="Negotiation">

    <div class="drop-zone"
     ondragover="allowDrop(event)"
     ondrop="dropLead(event)">

<h3>
Negotiation
(<%= buyers.filter(b => b.status === "Negotiation").length %> |
<%= formatAmount(getColumnValue("Negotiation")) %>)
</h3>

<% buyers
    .filter(b => b.status === "Negotiation")
    .forEach(function(b){ %>

        <%- include("partials/unqualifiedLeadCard", {
    buyer: b,
    getLeadAge: getLeadAge
}) %>

    <% }) %>

</div>

