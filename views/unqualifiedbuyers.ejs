<script>

let draggedLeadId = null;
let draggedCard = null;

document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".lead-card").forEach(card => {
        card.draggable = true;
    });
});

function dragLead(event) {

    draggedCard = event.currentTarget;
    draggedLeadId = draggedCard.dataset.id;

    console.log("Lead:", draggedLeadId);

    event.dataTransfer.setData("text/plain", draggedLeadId);
    event.dataTransfer.effectAllowed = "move";

}

function toggleDetails(id) {
    const div = document.getElementById("details-" + id);
    div.style.display = div.style.display === "none" ? "block" : "none";
}

async function dropLead(event) {

const dropZone = event.currentTarget;

    event.preventDefault();

const newStatus =
    dropZone.closest(".kanban-column").dataset.status;

    try {

console.log("Before fetch");

        const response = await fetch(

            "/buyer/status-unqualified-drag/" + draggedLeadId,
            {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                body: "status=" + encodeURIComponent(newStatus)
            }
        );

const result = await response.json();

if (!result.success) {
    alert("Unable to update lead status.");
    return;
}

if (!draggedCard) {
    console.error("draggedCard is null");
    return;
}

dropZone.appendChild(draggedCard);

document
    .querySelectorAll(".drag-over")
    .forEach(el => el.classList.remove("drag-over"));

    } catch (err) {

        console.error(err);
        alert("Unable to update lead.");

    }

    draggedLeadId = null;
    draggedCard = null;

}

function allowDrop(event) {

    event.preventDefault();

    event.currentTarget.classList.add("drag-over");

}

</script>

</body>

</html>