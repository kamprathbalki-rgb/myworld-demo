<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat Bot</title>

    <link rel="stylesheet" href="/chatbot/css/chatbot.css">
</head>
<body>

<div class="chat-container">

<div class="chat-header">
<h2>🤖 AI Property Assistant</h2>

<small class="chat-datetime">

    <span id="chatDate"></span>

    <span class="separator">•</span>

    <span id="chatTime"></span>

    <span class="separator">•</span>

    <span id="sessionStatus">🟢 Chat Active</span>

    <button id="endSession">🛑 End Chat</button>

    <button id="newChat" disabled>🆕 Start New Chat</button>

</small></div>

    <div id="messages"></div>

<div class="input-area">
<textarea
    id="message"
    rows="5"
    placeholder="Describe your property requirement..."
    autocomplete="off"></textarea>

    <button id="send">Send</button>
</div>

</div>

<script>
    const tenant = "<%= tenant %>";
</script>

<script src="/chatbot/js/chatbot.js"></script>

</body>
</html>