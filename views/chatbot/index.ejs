<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat Bot</title>

    <link rel="stylesheet" href="/chatbot/css/chatbot.css">
</head>
<body>

<div class="chat-container">

<div class="chat-header">
