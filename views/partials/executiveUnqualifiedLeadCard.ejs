<div class="lead-card"
     draggable="true"
     data-id="<%= buyer._id %>"
     ondragstart="dragLead(event)">

    <h4><%= buyer.name %></h4>

<%
const age = getLeadAge(buyer.createdAt);
%>

<div style="
    display:inline-block;
    padding:4px 8px;
    margin-bottom:8px;
    border-radius:12px;
    background:<%= age.color %>;
    color:white;
    font-size:11px;
    font-weight:bold;
">
    ⏳ <%= age.label %>
</div>

    <div>📞 <%= buyer.phone %></div>

    <div>💰 <%= buyer.minBudget %> - <%= buyer.maxBudget %></div>

    <div>📍 <%= buyer.primaryLocation || "-" %></div>

    <div>🏢 <%= buyer.requiredFlatType || "-" %></div>

<div>📅 Last Follow-up:
    <%= buyer.lastFollowUp
        ? new Date(buyer.lastFollowUp).toLocaleDateString("en-IN")
        : "-" %>
</div>

<div>⏰ Next Follow-up:
    <%= buyer.nextFollowUp
        ? new Date(buyer.nextFollowUp).toLocaleDateString("en-IN")
        : "-" %>
</div>

    <form
    method="POST"
    action="/executive/status-unqualified/<%= buyer._id %>"
    onsubmit="return false;">

<select
    name="status"
    onchange="alert('JS Running');changeBuyerStatus(this);">

            <option value="Imported"
                <%= buyer.status==="Imported" ? "selected" : "" %>>
                Imported
            </option>

            <option value="Contacted"
                <%= buyer.status==="Contacted" ? "selected" : "" %>>
                Contacted
            </option>

            <option value="Site Visit"
                <%= buyer.status==="Site Visit" ? "selected" : "" %>>
                Site Visit
            </option>

            <option value="Negotiation"
                <%= buyer.status==="Negotiation" ? "selected" : "" %>>
                Negotiation
            </option>

            <option value="Qualified"
                <%= buyer.status==="Qualified" ? "selected" : "" %>>
                Qualified
            </option>

        </select>

    </form>

<script>

async function changeBuyerStatus(select) {

    console.log("========== changeBuyerStatus ==========");

    const form = select.form;

    console.log("Action:", form.action);

    console.log("Status:", select.value);

    const formData = new FormData(form);

    for (const pair of formData.entries()) {
        console.log(pair[0], "=", pair[1]);
    }

    const response = await fetch(form.action, {
        method: "POST",
        body: formData
    });

    console.log("HTTP Status:", response.status);

    const text = await response.text();

    console.log("Response:", text);

    if (response.ok && text === "") {
        location.reload();
        return;
    }

    alert(text);
}

</script>

</div>

<div class="card-actions">

<a href="/executive/edit-unqualified/<%= buyer._id %>"
   class="card-btn edit-btn">
        ✏️ Edit
    </a>

<a href="/executive/matches/<%= buyer._id %>"
       class="card-btn match-btn">
        🏠 Matches
    </a>

</div>

<div class="card-actions">

    <a href="/executive/edit-unqualified/<%= buyer._id %>"
       class="card-btn edit-btn">
        ✏️ Edit
    </a>

    <button type="button"
            class="card-btn details-btn"
            onclick="toggleDetails('<%= buyer._id %>')">
        👁 Details
    </button>

</div>

<div id="details-<%= buyer._id %>" class="lead-details" style="display:none;">

    <hr>

    <div><strong>Source:</strong> <%= buyer.leadSource %></div>

    <div><strong>Requirement:</strong> <%= buyer.requiredFlatType || "-" %></div>

    <div><strong>Location:</strong> <%= buyer.primaryLocation || "-" %></div>

    <div><strong>Budget:</strong> ₹<%= buyer.minBudget %> - ₹<%= buyer.maxBudget %></div>

    <div><strong>Status:</strong> <%= buyer.status %></div>

    <hr>

<div>
    <strong>Latest Remarks</strong>
</div>

<div style="
    background:#f8f9fa;
    padding:8px;
    border-radius:6px;
    margin-top:5px;
    font-size:12px;
">
    <%= buyer.notes || "No remarks available." %>
</div>

</div>