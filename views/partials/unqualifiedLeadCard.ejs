<div class="lead-card"
     draggable="true"
     data-id="<%= buyer._id %>"
     ondragstart="dragLead(event)">

    <h4><%= buyer.name %></h4>

<%
const age = getLeadAge(buyer.createdAt);
%>

<div style="
    display:inline-block;
    padding:4px 8px;
    margin-bottom:8px;
    border-radius:12px;
    background:<%= age.color %>;
    color:white;
    font-size:11px;
    font-weight:bold;
">
    ⏳ <%= age.label %>
</div>

    <div>📞 <%= buyer.phone %></div>

    <div>💰 <%= buyer.minBudget %> - <%= buyer.maxBudget %></div>

    <div>📍 <%= buyer.primaryLocation || "-" %></div>

    <div>🏢 <%= buyer.requiredFlatType || "-" %></div>

    <div class="executive-row">

    <span class="executive-name">
        👨‍💼 <%= buyer.assignedExecutiveName || "Unassigned" %>
    </span>

    <a href="/executive/edit-unqualified/<%= buyer._id %>#assignment"
       class="reassign-link">
        Reassign
    </a>

</div>

<div>📅 Last Follow-up:
    <%= buyer.lastFollowUp
        ? new Date(buyer.lastFollowUp).toLocaleDateString("en-IN")
        : "-" %>
</div>

<div>⏰ Next Follow-up:
    <%= buyer.nextFollowUp
        ? new Date(buyer.nextFollowUp).toLocaleDateString("en-IN")
        : "-" %>
</div>

    <form method="POST" action="/buyer/status-unqualified/<%= buyer._id %>">

        <select
    name="status"
    <%= (typeof locals !== "undefined" && locals.disableStatus) ? "disabled" : "" %>
    onchange="this.form.submit()">

<% if (buyer.status === "Imported") { %>

    <option value="Imported" selected>Imported</option>
    <option value="Phone Call">Phone Call</option>

<% } else if (buyer.status === "Phone Call") { %>

    <option value="Phone Call" selected>Phone Call</option>
    <option value="Imported">Imported</option>

<% } else if (buyer.status === "Qualified") { %>

    <option value="Qualified" selected>Qualified</option>
    <option value="Site Visit">Site Visit</option>
    <option value="Not Responding">Not Responding</option>

<% } else if (buyer.status === "Site Visit") { %>

    <option value="Site Visit" selected>Site Visit</option>
    <option value="Negotiation">Negotiation</option>
    <option value="No Show">No Show</option>

<% } else if (buyer.status === "Negotiation") { %>

    <option value="Negotiation" selected>Negotiation</option>
    <option value="Deal Won">Deal Won</option>
    <option value="Lost">Lost</option>

<% } else { %>

    <option value="Imported" <%= buyer.status === "Imported" ? "selected" : "" %>>Imported</option>
    <option value="Phone Call" <%= buyer.status === "Phone Call" ? "selected" : "" %>>Phone Call</option>
    <option value="Qualified" <%= buyer.status === "Qualified" ? "selected" : "" %>>Qualified</option>
    <option value="WhatsApp Verification" <%= buyer.status === "WhatsApp Verification" ? "selected" : "" %>>WhatsApp Verification</option>
    <option value="Contacted" <%= buyer.status === "Contacted" ? "selected" : "" %>>Contacted</option>
    <option value="Follow-Up" <%= buyer.status === "Follow-Up" ? "selected" : "" %>>Follow-Up</option>
    <option value="Site Visit" <%= buyer.status === "Site Visit" ? "selected" : "" %>>Site Visit</option>
    <option value="Negotiation" <%= buyer.status === "Negotiation" ? "selected" : "" %>>Negotiation</option>
    <option value="Transaction" <%= buyer.status === "Transaction" ? "selected" : "" %>>Transaction</option>
    <option value="Lost" <%= buyer.status === "Lost" ? "selected" : "" %>>Lost</option>
    <option value="Not Responding" <%= buyer.status === "Not Responding" ? "selected" : "" %>>Not Responding</option>

<% } %>
        </select>

<%- include("workflowFields", { buyer: buyer }) %>

    </form>

<div class="card-actions">

    <a href="/executive/edit-unqualified/<%= buyer._id %>"
       class="card-btn edit-btn">
        ✏️ Edit
    </a>

    <a href="/buyer/matches/<%= buyer._id %>"
       class="card-btn match-btn">
        🏠 Matches
    </a>

    <button type="button"
            class="card-btn details-btn"
            onclick="toggleDetails('<%= buyer._id %>')">
        👁 Details
    </button>

</div>

<div id="details-<%= buyer._id %>" class="lead-details" style="display:none;">

    <hr>

    <div><strong>Source:</strong> <%= buyer.leadSource %></div>

    <div><strong>Requirement:</strong> <%= buyer.requiredFlatType || "-" %></div>

    <div><strong>Location:</strong> <%= buyer.primaryLocation || "-" %></div>

    <div><strong>Budget:</strong> ₹<%= buyer.minBudget %> - ₹<%= buyer.maxBudget %></div>

    <div><strong>Status:</strong> <%= buyer.status %></div>

    <hr>

<div>
    <strong>Latest Remarks</strong>
</div>

</div>

<div style="
    background:#f8f9fa;
    padding:8px;
    border-radius:6px;
    margin-top:5px;
    font-size:12px;
">
    <%= buyer.notes || "No remarks available." %>
</div>

</div>