<!DOCTYPE html>
<html>
<head>
    <title>AI Chat Lead</title>
    <style>
        body{
            font-family:Arial;
            padding:20px;
        }

        table{
            border-collapse:collapse;
            width:600px;
        }

        td{
            border:1px solid #ddd;
            padding:10px;
        }

        td:first-child{
            font-weight:bold;
            width:180px;
            background:#f5f5f5;
        }

        a{
            text-decoration:none;
        }
    </style>
</head>

<body>

<h2>🤖 AI Chat Lead</h2>

<p>
    <a href="/admin/chat-leads">← Back to List</a>
</p>

<table>

<tr>
<td>Name</td>
<td><%= lead.name || "-" %></td>
</tr>

<tr>
<td>Mobile</td>
<td><%= lead.mobile || "-" %></td>
</tr>

<tr>
<td>Email</td>
<td><%= lead.email || "-" %></td>
</tr>

<tr>
<td>Location</td>
<td><%= lead.location || "-" %></td>
</tr>

<tr>
<td>Property Type</td>
<td><%= lead.propertyType || "-" %></td>
</tr>

<tr>
<td>Budget</td>
<td><%= lead.budget || "-" %></td>
</tr>

<tr>
<td>Status</td>
<td><%= lead.status %></td>
</tr>

<tr>
<td>Created</td>
<td><%= lead.createdAt.toLocaleString("en-IN") %></td>
</tr>

</table>

</body>
</html>