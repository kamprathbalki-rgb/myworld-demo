<!DOCTYPE html>

<html>

<head>

<title>AI Chat Leads</title>

<style>

body{
    font-family:Arial;
    padding:20px;
}

table{

    width:100%;
    border-collapse:collapse;

}

th,
td{

    border:1px solid #ddd;
    padding:10px;

}

th{

    background:#1f4e79;
    color:white;

}

tr:nth-child(even){

    background:#f8f8f8;

}

a{

    text-decoration:none;

}

</style>

</head>

<body>

<div style="
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:20px;
">

<div>

<a
href="/dashboard/main"
style="
display:inline-block;
padding:10px 18px;
background:#1f4e79;
color:white;
text-decoration:none;
border-radius:6px;
margin-right:10px;
">
🏠 Dashboard
</a>

<a
href="javascript:history.back()"
style="
display:inline-block;
padding:10px 18px;
background:#6c757d;
color:white;
text-decoration:none;
border-radius:6px;
">
← Back
</a>

</div>

<h2 style="margin:0;">
🤖 AI Chat Leads
</h2>

</div>

<table>

<tr>

<th>Date</th>

<th>Name</th>

<th>Mobile</th>

<th>Email</th>

<th>Location</th>

<th>Type</th>

<th>Budget</th>

<th>Status</th>

<th></th>

</tr>

<%
chatLeads.forEach(function(lead){
%>

<tr>

<td>

<%= lead.createdAt.toLocaleDateString("en-IN") %>

</td>

<td>

<%= lead.name || "-" %>

</td>

<td>

<%= lead.mobile || "-" %>

</td>

<td>

<%= lead.email || "-" %>

</td>

<td>

<%= lead.location || "-" %>

</td>

<td>

<%= lead.propertyType || "-" %>

</td>

<td>

<%= lead.budget || "-" %>

</td>

<td>

<%= lead.status %>

</td>

<td>

<a href="/admin/chat-leads/<%= lead._id %>">

View

</a>

</td>

</tr>

<%
})
%>

</table>

</body>

</html>