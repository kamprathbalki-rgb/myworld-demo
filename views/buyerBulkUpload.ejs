<form
    action="/buyer/bulk-upload"
    method="POST"
    enctype="multipart/form-data"
>

<div class="file-group">
    <label>Buyer Upload File</label>

    <input
        type="file"
        name="excelFile"
        accept=".csv,.xlsx"
        required
        class="file-input">
</div>

<hr style="margin:25px 0">

<h3 style="margin-bottom:15px;color:#1f4e79;">
Column Mapping
</h3>

<p class="upload-note">
Select which column in your Excel/CSV contains each MyWorld field.
</p>

<%
const columns=[];

for(let i=0;i<52;i++){

    let col='';

    let n=i;

    do{

        col=
        String.fromCharCode(65+(n%26))
        +col;

        n=Math.floor(n/26)-1;

    }while(n>=0);

    columns.push(col);

}
%>

<%
const fields=[
['name','Buyer Name *'],
['phone','Mobile *'],
['email','Email'],
['primaryLocation','Primary Location'],
['minBudget','Min Budget'],
['maxBudget','Max Budget'],
['propertyType','Property Type'],
['configuration','Configuration'],
['transactionType','Transaction Type'],
['remarks','Remarks']
];
%>

<table style="width:100%;border-collapse:collapse">

<% fields.forEach(f=>{ %>

<tr>

<td style="padding:10px 0;width:45%">
<b><%=f[1]%></b>
</td>

<td>

<select
name="map_<%=f[0]%>"
style="width:180px;padding:8px">

<option value="">
Not Available
</option>

<% columns.forEach(c=>{ %>

<option value="<%=c%>">
Column <%=c%>
</option>

<% }) %>

</select>

</td>

</tr>

<% }) %>

</table>

<br>

<div class="form-actions">

<a
href="/dashboard"
class="cancel-btn">
Cancel
</a>

<button
type="submit"
class="upload-btn">

Import Unqualified Leads

</button>

</div>

</form>